+const COMPACT_USAGE_BAR_SEGMENTS: usize = 8;
+
+fn claude_git_branch(branch: &str, dirty: bool) -> String {
+    format!("git:({branch}){}", if dirty { " *" } else { "" })
+}
+
+fn compact_usage_meter(
+    label: &str,
+    used_percent: f64,
+    reset_at: Option<DateTime<Local>>,
+    now: DateTime<Local>,
+) -> String {
+    let used_percent = used_percent.clamp(0.0, 100.0);
+    let filled = ((used_percent * COMPACT_USAGE_BAR_SEGMENTS as f64 / 100.0).round() as usize)
+        .min(COMPACT_USAGE_BAR_SEGMENTS);
+    let bar = format!(
+        "{}{}",
+        "█".repeat(filled),
+        "░".repeat(COMPACT_USAGE_BAR_SEGMENTS - filled)
+    );
+    let mut text = format!("{label} {bar} {used_percent:.0}%");
+    if let Some(reset_at) = reset_at {
+        let seconds = reset_at.signed_duration_since(now).num_seconds();
+        if seconds > 0 {
+            let days = seconds / 86_400;
+            let hours = seconds % 86_400 / 3_600;
+            let minutes = seconds % 3_600 / 60;
+            let countdown = if days > 0 {
+                format!("{days}d{hours}h")
+            } else if hours > 0 {
+                format!("{hours}h{minutes:02}m")
+            } else if minutes > 0 {
+                format!("{minutes}m")
+            } else {
+                "<1m".to_string()
+            };
+            text.push_str(&format!(" (in {countdown})"));
+        }
+    }
+    text
+}
+
+fn compact_unknown_usage_meter(label: &str) -> String {
+    format!("{label} {} ?", "░".repeat(COMPACT_USAGE_BAR_SEGMENTS))
+}
