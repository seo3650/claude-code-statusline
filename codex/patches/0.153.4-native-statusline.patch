+fn compact_usage_bar_spans(
+    text: &str,
+    label_style: Style,
+    use_colors: bool,
+) -> Option<Vec<Span<'static>>> {
+    let (label, rest) = text.split_once(' ')?;
+    let (meter, rest) = rest.split_once(' ')?;
+    if meter.chars().count() != 8 || !meter.chars().all(|glyph| matches!(glyph, '█' | '░')) {
+        return None;
+    }
+    let filled = meter.chars().take_while(|glyph| *glyph == '█').count();
+    if meter.chars().skip(filled).any(|glyph| glyph != '░') {
+        return None;
+    }
+    let (percent, suffix) = rest
+        .split_once(' ')
+        .map_or((rest, ""), |(percent, suffix)| (percent, suffix));
+    let used_percent = percent
+        .strip_suffix('%')
+        .and_then(|value| value.parse::<u8>().ok())
+        .map(|value| value.min(100));
+    if used_percent.is_none() && percent != "?" {
+        return None;
+    }
+
+    let used_style = if use_colors {
+        match used_percent {
+            Some(0..=59) => Style::default().green(),
+            Some(60..=84) => Style::default().yellow(),
+            Some(_) => Style::default().red(),
+            None => Style::default().dim(),
+        }
+    } else {
+        Style::default().dim()
+    };
+    let empty_style = Style::default().dim();
+    let mut spans = vec![Span::styled(format!("{label} "), label_style)];
+    if filled > 0 {
+        spans.push(Span::styled("█".repeat(filled), used_style));
+    }
+    if filled < 8 {
+        spans.push(Span::styled("█".repeat(8 - filled), empty_style));
+    }
+    spans.push(Span::styled(format!(" {percent}"), used_style));
+    if !suffix.is_empty() {
+        spans.push(Span::styled(format!(" {suffix}"), empty_style));
+    }
+    Some(spans)
+}
