#!/bin/sh
# Raise only this Codex process's descriptor limit, then run the native patched CLI.
set -eu
if [ -n "${HOME:-}" ]; then
    user_home=$HOME
else
    user_home=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fi
soft=$(ulimit -S -n)
hard=$(ulimit -H -n)
target=4096
case "$hard" in unlimited) ;; *) [ "$hard" -lt "$target" ] && target=$hard ;; esac
if [ "$soft" != unlimited ] && [ "$soft" -lt "$target" ]; then
    ulimit -S -n "$target" || { echo 'Codex: cannot raise file descriptor limit' >&2; exit 1; }
fi
patched="${CODEX_PATCHED_BIN:-$user_home/.local/share/codex-statusline/bin/codex}"
official="${CODEX_REAL_BIN:-$user_home/.codex/packages/standalone/current/bin/codex}"
if [ -x "$patched" ]; then
    exec "$patched" "$@"
fi
exec "$official" "$@"
